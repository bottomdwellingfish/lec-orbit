{
  "name": "@lec-orbit/server",
  "version": "1.0.0",
  "private": true,
  "description": "乐程 Orbit & LecPunch 统一核心后端（NestJS 12 + @nestjs/platform-node + TypeORM + PostgreSQL）",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "dev:node": "nest start --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run dist/main.js",
    "start:node": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test specs/",
    "migration:run": "bun run src/database/run-migrations.ts",
    "migrate:mongo:dry-run": "bun run src/database/migration-tool/migrate-mongo-to-pg.ts --dry-run",
    "migrate:mongo": "bun run src/database/migration-tool/migrate-mongo-to-pg.ts",
    "migrate:mongo:verify": "bun run src/database/migration-tool/migrate-mongo-to-pg.ts --verify-only"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-node": "^12.6.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "ioredis": "^5.6.1",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "mongodb": "^7.9.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "typeorm": "^1.1.3",
    "ws": "^8.23.0",
    "yauzl": "^3.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.6.0",
    "@types/node": "^22.20.7",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^2.10.3",
    "fflate": "^0.8.2",
    "typescript": "^5.9.3"
  }
}
